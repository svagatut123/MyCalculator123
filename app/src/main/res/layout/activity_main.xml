<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Output Display Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/operation"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:gravity="end|bottom"
            android:textSize="50sp"
            android:ellipsize="start"
            android:singleLine="true" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:gravity="end|top"
            android:textSize="30sp"
            android:ellipsize="start"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Buttons Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:orientation="vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/b_sqrt" style="@style/Operations_Sci" android:text="sqrt" />
            <TextView android:id="@+id/b_log2" style="@style/Operations_Sci" android:text="log2" />
            <TextView android:id="@+id/b_ln" style="@style/Operations_Sci" android:text="ln" />
            <TextView android:id="@+id/b_leftb" style="@style/Operations_Sci" android:text="(" />
            <TextView android:id="@+id/b_rightb" style="@style/Operations_Sci" android:text=")" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/b_sin" style="@style/Operations_Sci" android:text="sin" />
            <TextView android:id="@+id/b_cos" style="@style/Operations_Sci" android:text="cos" />
            <TextView android:id="@+id/b_tan" style="@style/Operations_Sci" android:text="tan" />
            <TextView android:id="@+id/b_log" style="@style/Operations_Sci" android:text="log" />
            <TextView android:id="@+id/b_pow" style="@style/Operations_Sci" android:text="^" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/b_7" style="@style/Numbers" android:text="7" />
            <TextView android:id="@+id/b_8" style="@style/Numbers" android:text="8" />
            <TextView android:id="@+id/b_9" style="@style/Numbers" android:text="9" />
            <TextView android:id="@+id/b_div" style="@style/Operations" android:text="/" />
            <TextView android:id="@+id/b_clear" style="@style/Operations" android:text="AC" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/b_4" style="@style/Numbers" android:text="4" />
            <TextView android:id="@+id/b_5" style="@style/Numbers" android:text="5" />
            <TextView android:id="@+id/b_6" style="@style/Numbers" android:text="6" />
            <TextView android:id="@+id/b_mul" style="@style/Operations" android:text="*" />
            <TextView android:id="@+id/b_back" style="@style/Operations" android:text="DEL" />
        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/b_1" style="@style/Numbers" android:text="1" />
            <TextView android:id="@+id/b_2" style="@style/Numbers" android:text="2" />
            <TextView android:id="@+id/b_3" style="@style/Numbers" android:text="3" />
            <TextView android:id="@+id/b_minus" style="@style/Operations" android:text="-" />
            <TextView android:id="@+id/b_pi" style="@style/Operations_Sci" android:text="pi" />
        </LinearLayout>

        <!-- Row 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/b_0" style="@style/Numbers" android:text="0" />
            <TextView android:id="@+id/b_dot" style="@style/Numbers" android:text="." />
            <TextView android:id="@+id/b_e" style="@style/Operations_Sci" android:text="e" />
            <TextView android:id="@+id/b_plus" style="@style/Operations" android:text="+" />
            <TextView android:id="@+id/b_eq"
                style="@style/Operations"
                android:background="@color/color_equal"
                android:textColor="@color/white"
                android:text="=" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>